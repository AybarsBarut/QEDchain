project ChainGuard is
   for Source_Dirs use ("src", "cli", "tests");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("chainguard_cli.adb", "test_runner.adb");
   package Builder is
      for Executable ("chainguard_cli.adb") use "chainguard";
   end Builder;
   package Compiler is
      -- Ghost chain predicates are linear; evaluating them on every append
      -- would make bulk construction quadratic. GNATprove checks every contract
      -- independently of the runtime assertion policy.
      for Default_Switches ("Ada") use ("-gnat2012", "-gnato", "-g", "-O1");
   end Compiler;
   package Prove is
      for Proof_Dir use "proof";
   end Prove;
end ChainGuard;
